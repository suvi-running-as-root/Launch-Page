# Change these values before production deployment. Do not commit a real .env file.
ADMIN_USER=admin?maybe
ADMIN_PASS=QwErTyUiOp

# A long random secret used by the payment-integration webhook.
ZEFFY_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Comma-separated public frontend URL(s). Leave blank only for local development.
CORS_ORIGIN=https://your-domain.example

# SMTP account used by the Contact Us form. Use a verified amarsevausa.org address.
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USER=contact@amarsevausa.org
SMTP_PASS=replace-with-your-smtp-password
CONTACT_FROM_EMAIL="Amar Seva Sangam USA" <contact@amarsevausa.org>
CONTACT_TO_EMAIL=contact@amarsevausa.org
